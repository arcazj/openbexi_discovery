# Copy to .env locally. Leave the key blank to browse without AI.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=xhigh
# Connect AI also configures anthropic, gemini, deepseek, openrouter, or custom.
# Each uses separate PREFIX_API_KEY, PREFIX_MODEL, and PREFIX_REASONING_EFFORT
# settings (prefixes: ANTHROPIC, GEMINI, DEEPSEEK, OPENROUTER, CUSTOM_AI).
# Custom providers also require CUSTOM_AI_BASE_URL (HTTPS, e.g. https://host/v1).
# Optional NCBI contact address; not a credential.
NCBI_EMAIL=
